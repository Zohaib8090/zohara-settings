[Desktop Entry]
Type=Service
Name=Zohara
MimeType=application/gzip;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-zstd-compressed-tar;application/x-lzma-compressed-tar;application/x-tar;
Actions=zohara-install-archive;
X-KDE-Submenu=Zohara

[Desktop Action zohara-install-archive]
Name=Install as an app
Icon=system-software-install
Exec=/usr/bin/zohara-settings --install-archive %f
