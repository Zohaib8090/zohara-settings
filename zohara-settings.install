# Turns on the background update check and the automatic time zone for every user. The ISO does the same for a fresh
# install; this hook is what gives machines that were installed earlier the new timers when they update Settings.
post_install() {
    systemctl --global enable zohara-settings-update-check.timer >/dev/null 2>&1 || true
    systemctl --global enable zohara-settings-timezone.timer >/dev/null 2>&1 || true
    fix_localtime
    update_logo
    update_release
    fix_settings_launcher
}

post_upgrade() {
    post_install
}

# Older installs carry /etc/tmpfiles.d/zohara-localtime.conf with a force rule ("L+ /etc/localtime ... UTC"). systemd
# applies it at every boot and after package updates, so the time zone fell back to UTC each time. The ISO now ships a
# real /etc/localtime link instead, so on an installed system the rule is switched off. (Not on the live ISO.)
fix_localtime() {
    rule=/etc/tmpfiles.d/zohara-localtime.conf
    if [ -f "$rule" ] && grep -q '^L+' "$rule" && [ ! -e /run/archiso ]; then
        printf '%s\n' '# Switched off by zohara-settings: this rule reset the time zone to UTC at every boot and update.' \
            '# The time zone now follows Settings > Time & language (and automatic time zone).' > "$rule"
    fi
    # A plain-text /etc/localtime (an old overlay quirk) is not a time zone at all: make it a real link.
    if [ -e /etc/localtime ] && [ ! -L /etc/localtime ]; then
        ln -sf /usr/share/zoneinfo/UTC /etc/localtime
    fi
}

# The terminal's banner logo is a file of the ISO's overlay (no package owns it, so a package cannot simply replace
# it). Machines installed earlier had an older drawing: copy the current one over it. A note of what was copied last
# lets a person's own edit stay: the file is only replaced when it is still the one Zohara put there (or when it is
# one of the older Zohara drawings, which were never recorded). Not on the live ISO, which ships the current one.
update_logo() {
    dst=/usr/share/zohara-logo.txt
    src=/usr/share/zohara/zohara-logo.txt
    note=/usr/share/zohara/logo-installed.sha256
    [ -f "$src" ] && [ ! -e /run/archiso ] || return 0
    new=$(sha256sum "$src" | cut -d' ' -f1)
    now=$(sha256sum "$dst" 2>/dev/null | cut -d' ' -f1)
    last=$(cat "$note" 2>/dev/null)
    if [ "$now" != "$new" ] && { [ -z "$last" ] || [ "$now" = "$last" ] || [ -z "$now" ]; }; then
        cp "$src" "$dst"
    fi
    printf '%s\n' "$new" > "$note"
}

# Zohara OS 1.1: machines installed from an older image have the build date as their version in /etc/os-release. Show
# the release number instead (About reads it). Only a date-style version is changed; the live ISO is left alone.
update_release() {
    f=/etc/os-release
    [ -f "$f" ] && [ ! -e /run/archiso ] || return 0
    if grep -Eq '^VERSION="?20[0-9]{2}\.[0-9]{2}\.[0-9]{2}"?$' "$f"; then
        sed -i -E \
            -e 's/^PRETTY_NAME=.*/PRETTY_NAME="Zohara OS 1.1"/' \
            -e 's/^VERSION=.*/VERSION="1.1"/' \
            -e 's/^VERSION_ID=.*/VERSION_ID="1.1"/' "$f"
    fi
}

# The taskbar pins "systemsettings" (the ISO makes that launcher open Zohara Settings). Plasma pairs an open window with
# a pinned launcher by the window's app id, and ours is os.zohara.Settings, so the open window showed up as a second
# icon beside the pinned one, with another picture. Give the pinned launcher our icon and our app id so they are one.
# Only touched when it really starts Zohara Settings; the other file lines stay as they were.
fix_settings_launcher() {
    f=/usr/share/applications/systemsettings.desktop
    [ -f "$f" ] && grep -q '^Exec=zohara-settings' "$f" || return 0
    sed -i -e 's/^Icon=.*/Icon=zohara-settings/' -e '/^StartupWMClass=/d' "$f"
    printf '%s\n' 'StartupWMClass=os.zohara.Settings' >> "$f"
}
