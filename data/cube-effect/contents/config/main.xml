<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
    <kcfgfile name=""/>
    <group name="">
        <!-- how long the turn takes after you let go (milliseconds) -->
        <entry name="Duration" type="Int">
            <default>450</default>
        </entry>
        <!-- true: the faces cover half a circle with a gap between the last and the first desktop (like Zorin); false: a closed prism -->
        <entry name="OpenCube" type="Bool">
            <default>true</default>
        </entry>
        <!-- how far the cube moves away from you while it turns, 0 to 1 -->
        <entry name="Pullback" type="Double">
            <default>0.6</default>
        </entry>
        <!-- vertical tilt in degrees while turning -->
        <entry name="Tilt" type="Double">
            <default>0</default>
        </entry>
        <!-- 0 to 1: how much a window floats in front of its face (parallax) -->
        <entry name="Parallax" type="Double">
            <default>0.5</default>
        </entry>
        <!-- true: 4 fingers up opens the cube's overview (and KWin's own Overview is off); false: leave that gesture to KWin's Overview -->
        <entry name="OverviewGesture" type="Bool">
            <default>true</default>
        </entry>
        <!-- true: the desktop bar and window tray glide in and out of the overview; false: they appear at once -->
        <entry name="TrayAnimation" type="Bool">
            <default>true</default>
        </entry>
        <!-- how long that glide takes (milliseconds) -->
        <entry name="TrayTime" type="Int">
            <default>350</default>
        </entry>
        <!-- the overview's side panel: every open window of every desktop, down the left side -->
        <entry name="SidePanel" type="Bool">
            <default>true</default>
        </entry>
        <!-- true: each window in the panel shows its picture; false: only its icon and name -->
        <entry name="SidePanelPreview" type="Bool">
            <default>true</default>
        </entry>
        <!-- the panel's width in pixels -->
        <entry name="SidePanelWidth" type="Int">
            <default>280</default>
        </entry>
        <!-- how see-through the panel is, 0.3 to 1 -->
        <entry name="SidePanelOpacity" type="Double">
            <default>0.85</default>
        </entry>
        <!-- 0 dark, 1 light -->
        <entry name="SidePanelStyle" type="Int">
            <default>0</default>
        </entry>
        <!-- true: the panel glides in from the left (taking TrayTime); false: it appears at once -->
        <entry name="SidePanelAnimation" type="Bool">
            <default>true</default>
        </entry>
        <!-- true: the window under the pointer grows a little and lights up -->
        <entry name="SidePanelHover" type="Bool">
            <default>true</default>
        </entry>
        <!-- scrolling in the overview: 0 up/down and left/right, 1 up/down only, 2 left/right only -->
        <entry name="ScrollMode" type="Int">
            <default>0</default>
        </entry>
        <!-- true: scroll the other way round -->
        <entry name="ScrollReverse" type="Bool">
            <default>false</default>
        </entry>
    </group>
</kcfg>
