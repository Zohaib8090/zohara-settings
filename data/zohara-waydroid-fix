#!/bin/bash
# Zohara OS helper for Waydroid (Android apps). Runs as root, from the two systemd services and from Settings.
#
#   zohara-waydroid-fix disguise    make the container report a normal release build instead of "userdebug / test-keys"
#                                   (apps that refuse "rooted devices" read exactly these markers). Offline, quick.
#   zohara-waydroid-fix arm         add ARM app support (Intel: libhoudini, AMD: libndk) when the person turned it on
#   zohara-waydroid-fix status      print what is applied (also written to $STATE/status for Settings)
#   zohara-waydroid-fix undo-disguise
#
# Never blocks or breaks Waydroid: every step is guarded, failures are written to the status file, the exit code is 0.
# Settings (/etc/zohara/waydroid.conf):  disguise=1 (default on)   arm=0 (default OFF: it downloads Intel's/Google's
# translation library onto this computer, so it needs the person's yes).
#
# Overlay: Waydroid lays /var/lib/waydroid/overlay over its system image. A build.prop there wins over the image's own and
# "undo" is deleting/reverting one file; the image itself is never changed.
#
# Tests point ZOHARA_WAYDROID_DIR / _CONF / _STATE / _IMAGE_DIR at a throwaway folder (see tests/waydroid-fix-test.sh).

set -u
W="${ZOHARA_WAYDROID_DIR:-/var/lib/waydroid}"
CONF="${ZOHARA_WAYDROID_CONF:-/etc/zohara/waydroid.conf}"
STATE="${ZOHARA_WAYDROID_STATE:-/var/lib/zohara/waydroid}"
IMG="${ZOHARA_WAYDROID_IMAGE:-$W/images/system.img}"
OVER_PROP="$W/overlay/system/build.prop"
# Every partition has its own build.prop with its own copy of the fingerprint (system, system_ext, product, vendor, odm,
# vendor_dlkm ...). Android compares them at boot and shows "There's an internal problem with your device. Contact your
# manufacturer" ("Build fingerprint is not consistent") when they disagree, so the developer markers must go from EVERY one
# (found 2026-11-22 and 2026-11-24: changing only system, then system and vendor, still left odm, system_ext and vendor_dlkm).
# The system image's root is laid under $W/overlay, the vendor image's root under $W/overlay/vendor.
VENDOR_IMG="${ZOHARA_WAYDROID_VENDOR_IMAGE:-$W/images/vendor.img}"
CPUINFO="${ZOHARA_WAYDROID_CPUINFO:-/proc/cpuinfo}"

# waydroid_script (GPL-3.0, casualsnek): the commit that was read and tested, never "latest". Bump together with a test run.
PIN_SHA="4a50dabd97fcb632a608b1421105258862a5b994"
PIN_URL="https://github.com/casualsnek/waydroid_script/archive/${PIN_SHA}.tar.gz"
PIN_TAR_SHA256="786a95136b8cb8f79646ed74ea11835a35148eba76e8f14a71363e3f6349a114"
PIP_PINS="tqdm==4.70.1 requests==2.34.2 InquirerPy==0.3.4"

mkdir -p "$STATE" 2>/dev/null || true
LOG="$STATE/last-error"
MANAGED="$STATE/managed-files"

setting() { # key default
    local v
    v=$(grep -E "^$1=" "$CONF" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d ' \r')
    echo "${v:-$2}"
}

fail() { echo "$*" > "$LOG"; echo "zohara-waydroid-fix: $*" >&2; }

have_image() { [ -f "$IMG" ]; }

image_id() { stat -c '%s-%Y' "$IMG" "$VENDOR_IMG" 2>/dev/null | tr '\n' '-'; }

# The same text with the developer-build tag turned into a release tag, and back. ONLY the tag changes ("test-keys" ->
# "release-keys"): apps that refuse "rooted devices" read the tags. The build TYPE stays "userdebug" on purpose: with
# "user" Android's own interface check (libvintf) becomes strict, Waydroid's device manifest fails it, and Android shows
# "There's an internal problem with your device. Contact your manufacturer" at every start (found 2026-11-24 by moving the
# overlay aside: the untouched Waydroid logs no "Vendor interface is incompatible"). `to_dev` also undoes what the first version
# of this helper wrote (it changed the type to "user" too).
to_release() { sed -e 's#:user/release-keys#:userdebug/release-keys#g' -e 's#^\(ro\.[a-z_.]*build\.type=\)user$#\1userdebug#' -e 's#-user \([0-9]\)#-userdebug \1#' -e 's/test-keys/release-keys/g'; }
to_dev() { sed -e 's/release-keys/test-keys/g' -e 's#:user/test-keys#:userdebug/test-keys#g' -e 's#^\(ro\.[a-z_.]*build\.type=\)user$#\1userdebug#' -e 's#-user \([0-9]\)#-userdebug \1#'; }

# Calls `$3` (a function) with the root folder of an image, mounted read-only for the call (so this works while Waydroid is
# stopped). Tests give a plain folder (`$2`) instead of an image.
with_image_root() {
    local img="$1" testroot="$2" cb="$3" mnt rc=0
    if [ -n "$testroot" ]; then "$cb" "$testroot"; return; fi
    [ -f "$img" ] || return 1
    mnt=$(mktemp -d) || return 1
    if mount -o ro,loop "$img" "$mnt" 2>/dev/null; then "$cb" "$mnt"; rc=$?; umount "$mnt" 2>/dev/null; else rc=1; fi
    rmdir "$mnt" 2>/dev/null
    return $rc
}

# For every build.prop in the image root that still carries a developer marker: the release version goes into the overlay,
# at the same path (under $OVERLAY_BASE). The overlay file is the source when it already exists (the ARM translator edits it too).
write_from_root() {
    local root="$1" f rel out src tmp
    tmp=$(mktemp) || return 1
    while IFS= read -r f; do
        rel="${f#"$root"/}"
        out="$OVERLAY_BASE/$rel"
        # an overlay file that is already there (written by an earlier version, or edited by the ARM translator) is the source
        # and is remembered as ours, even when it has no marker left
        if [ -f "$out" ]; then src="$out"; echo "$out" >> "$MANAGED"; else src="$f"; fi
        grep -qE 'test-keys|:user/release-keys|^ro\.[a-z_.]*build\.type=user$' "$src" 2>/dev/null || continue
        to_release < "$src" > "$tmp"
        install -D -m 644 "$tmp" "$out" && echo "$out" >> "$MANAGED"
    done < <(find "$root" -maxdepth 4 -name build.prop -type f 2>/dev/null | sort)
    rm -f "$tmp"
}

# Waydroid's own updater app (org.lineageos.waydroidupdater) pops up "update available" notices that fetch images behind
# Zohara Update's back. Hide it with an overlay whiteout (a character device 0:0 laid over the app folder), which the
# overlay filesystem treats as "this file is deleted"; the image is not touched. Found 2026-11-26 in the VM: Android then
# reports no such package. Needs root (mknod); without root nothing happens.
UPDATER_DIR="$W/overlay/system/system_ext/priv-app/WaydroidUpdater"
hide_updater() {
    [ -d "$W/overlay/system" ] || return 0
    [ -c "$UPDATER_DIR" ] && return 0
    rm -rf "$UPDATER_DIR" 2>/dev/null
    mkdir -p "$(dirname "$UPDATER_DIR")" 2>/dev/null || return 0
    mknod "$UPDATER_DIR" c 0 0 2>/dev/null && : > "$STATE/restart-needed"
    return 0
}
show_updater() {
    [ -c "$UPDATER_DIR" ] || return 0
    rm -f "$UPDATER_DIR" && : > "$STATE/restart-needed"
    return 0
}

disguise() {
    have_image || return 0
    if [ "$(setting disguise 1)" != 1 ]; then undo_disguise; return 0; fi
    local now old f tmp
    now=$(image_id)
    old=$(cat "$STATE/image-id" 2>/dev/null)
    # a new image (a Waydroid update), or the first run: the old overlay files belong to the old images, so start again
    local missing=0
    if [ -s "$MANAGED" ]; then while IFS= read -r f; do [ -f "$f" ] || missing=1; done < "$MANAGED"; fi
    if [ ! -s "$MANAGED" ] || [ "$old" != "$now" ] || [ "$missing" = 1 ]; then
        if [ -s "$MANAGED" ]; then while IFS= read -r f; do rm -f "$f"; done < "$MANAGED"; fi
        : > "$MANAGED"; rm -f "$STATE/arm-done"
        OVERLAY_BASE="$W/overlay"          with_image_root "$IMG" "${ZOHARA_WAYDROID_SYSTEM_ROOT:-}" write_from_root
        OVERLAY_BASE="$W/overlay/vendor"   with_image_root "$VENDOR_IMG" "${ZOHARA_WAYDROID_VENDOR_ROOT:-}" write_from_root
        sort -u "$MANAGED" -o "$MANAGED"
        if ! grep -q '^ro.build.tags=release-keys' "$OVER_PROP" 2>/dev/null; then
            fail "could not write the release markers (ro.build.tags not found in the system build.prop)"; return 0
        fi
        : > "$STATE/restart-needed"
    else
        # same images: only make sure the markers are still in place (the ARM translator may have rewritten a file)
        tmp=$(mktemp) || return 0
        while IFS= read -r f; do
            [ -f "$f" ] || continue
            to_release < "$f" > "$tmp"
            cmp -s "$tmp" "$f" || { install -m 644 "$tmp" "$f"; : > "$STATE/restart-needed"; }
        done < "$MANAGED"
        rm -f "$tmp"
    fi
    hide_updater
    echo "$now" > "$STATE/image-id"
}

undo_disguise() {
    local f tmp
    show_updater
    [ -s "$MANAGED" ] || return 0
    tmp=$(mktemp) || return 0
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        to_dev < "$f" > "$tmp"
        # nothing else in the overlay files (ARM lines) was added by the disguise, so only the markers move back
        install -m 644 "$tmp" "$f" && : > "$STATE/restart-needed"
    done < "$MANAGED"
    rm -f "$tmp"
}

arm_present() {
    { [ -f "$W/overlay/system/lib/libhoudini.so" ] || [ -f "$W/overlay/system/lib64/libhoudini.so" ] || \
      [ -f "$W/overlay/system/lib/libndk_translation.so" ] || [ -f "$W/overlay/system/lib64/libndk_translation.so" ]; } && \
    grep -qE '^ro\.dalvik\.vm\.native\.bridge=(libhoudini|libndk_translation)\.so' "$OVER_PROP" 2>/dev/null
}

cpu_translator() {
    if grep -qi 'GenuineIntel' "$CPUINFO" 2>/dev/null; then echo libhoudini
    elif grep -qi 'AuthenticAMD' "$CPUINFO" 2>/dev/null; then echo libndk
    else echo none; fi
}

arm() {
    have_image || return 0
    [ "$(setting arm 0)" = 1 ] || return 0
    if arm_present; then return 0; fi
    local tr; tr=$(cpu_translator)
    [ "$tr" != none ] || { fail "this computer's processor does not need or support ARM translation"; return 0; }
    command -v curl >/dev/null && command -v python3 >/dev/null && command -v lzip >/dev/null || { fail "needs curl, python3 and lzip installed"; return 0; }
    local tool="$STATE/waydroid_script"
    if [ ! -f "$tool/main.py" ]; then
        local tgz; tgz=$(mktemp)
        if ! curl -fsSL --max-time 300 -o "$tgz" "$PIN_URL"; then fail "no internet: ARM support will be tried again later"; rm -f "$tgz"; return 0; fi
        if [ "$(sha256sum "$tgz" | cut -d' ' -f1)" != "$PIN_TAR_SHA256" ]; then fail "the downloaded tool does not match the checked version; not used"; rm -f "$tgz"; return 0; fi
        rm -rf "$tool"; mkdir -p "$tool"
        tar -xzf "$tgz" -C "$tool" --strip-components=1 && rm -f "$tgz" || { fail "could not unpack the tool"; return 0; }
    fi
    if [ ! -x "$tool/venv/bin/python3" ]; then
        python3 -m venv "$tool/venv" && "$tool/venv/bin/pip" install -q $PIP_PINS || { fail "could not set up the tool (no internet?)"; rm -rf "$tool/venv"; return 0; }
    fi
    if (cd "$tool" && timeout 900 venv/bin/python3 main.py install "$tr" >"$STATE/arm.log" 2>&1) && arm_present; then
        : > "$STATE/restart-needed"; rm -f "$LOG"
        # the translator edits the overlay build.prop: put the release markers back on top of it
        disguise
    else
        fail "ARM support did not install; see $STATE/arm.log"
    fi
}

status() {
    {
        have_image && echo "waydroid=installed" || echo "waydroid=missing"
        grep -q '^ro.build.tags=release-keys' "$OVER_PROP" 2>/dev/null && echo "disguise=applied" || echo "disguise=not-applied"
        arm_present && echo "arm=present" || echo "arm=absent"
        echo "arm_wanted=$(setting arm 0)"
        echo "disguise_wanted=$(setting disguise 1)"
        echo "translator=$(cpu_translator)"
        [ -c "$UPDATER_DIR" ] && echo "updater=hidden" || echo "updater=shown"
        # Waydroid switches overlays off for good in waydroid.cfg when an overlay mount fails once (moving the overlay folder
        # does it); with overlays off it ignores every file this helper writes
        if grep -qE '^mount_overlays *= *False' "$W/waydroid.cfg" 2>/dev/null; then echo "overlays=off"; else echo "overlays=on"; fi
        [ -f "$STATE/restart-needed" ] && echo "restart=needed"
        [ -s "$LOG" ] && echo "error=$(head -c 300 "$LOG" | tr '\n' ' ')"
        grep -qE '^mount_overlays *= *False' "$W/waydroid.cfg" 2>/dev/null && echo "error=Waydroid has its overlays switched off (mount_overlays = False in /var/lib/waydroid/waydroid.cfg), so the changes of this helper are not used. Set it to True and restart Android."
    } | tee "$STATE/status"
}

case "${1:-}" in
    disguise) disguise; status >/dev/null ;;
    arm) arm; status >/dev/null ;;
    undo-disguise) undo_disguise; status >/dev/null ;;
    status) status ;;
    *) echo "usage: $0 disguise | arm | undo-disguise | status" >&2 ;;
esac
exit 0
